# Cloned product repos (registry symlink kept)
repos/*
!repos/README.md

# Cloned external references
references/*
!references/README.md

# Environment and credentials
.env
.service-access.local.json

# User-specific agent / IDE config (the .example templates stay tracked).
# NOTE: .claude/settings.json is deliberately NOT ignored — it carries only
# template-owned hook wiring (hooks + statusLine, nothing personal) and is
# committed so existing workspaces pick up wiring changes with git pull, like
# every other runtime's hook deployment (M31). Personal permissions belong in
# settings.local.json; Claude Code merges both files.
.vscode/mcp.json
.claude/settings.local.json
.mcp.json

# Context-budget runtime state (session registrations, hook throttle stamps)
# plus the hook-appended measurement ledger (context-ledger.jsonl — same class
# as .gemini/telemetry.log; not regenerable, so snapshot deliberately if
# mining it for analysis, never track the live file).
.context-budget/

# Live-session runtime state under work/ — meaningful only while a session is
# alive on this machine (liveness = artifact mtime, not file content); tracking
# it dirties every session and a checkout would resurrect stale locks.
# Durable work/ files (README, next-session.md, handoff.md, decisions.md,
# committed per-item context-budget.env) stay tracked.
work/*/.active-session
work/*/.agent-locks/
work/*/.agent-dispatch/
work/*/.rollover-options
work/*/.session-seq
work/*/.session-seq.provenance.json
work/*/.rollover-complete
work/*/.next-command
work/*/.session-loop
# The supervisor's own log. Load-bearing for stall detection, not just tidiness:
# it is appended on every iteration by construction, so a tracked copy would make
# "did this session commit something outside the bookkeeping set?" true forever
# and the guard could never fire (scripts/session-loop.sh, session_made_progress).
work/*/.session-loop.log
work/*/.hands-off
work/*/.interactive


# Gemini CLI local telemetry (token counts for context-budget; grows per session)
.gemini/telemetry.log

# Scratch
temp/
tmp/

# rlm skill runtime scratch (REPL state + audit replay packages)
.claude/rlm_state/
.claude/rlm_runs/

# graphify knowledge-graph output (regenerated locally)
graphify-out/

# OS cruft
.DS_Store

# Stack-specific — include only the entries that apply to your workspace
# .venv/           # Python virtualenv
# node_modules/    # Node deps
# .idea/           # JetBrains IDE files

# Session worktrees. These are nested git worktrees of THIS repo — tracking
# them would commit a checkout into its own history.
.claude/worktrees/

# Office lock / owner files, written beside a document while it is open.
# PowerPoint leaves them behind after a render.
~$*

# Editor and settings backups.
*.bak
