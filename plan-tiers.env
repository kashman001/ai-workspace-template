# Plan tiers (non-secret, checked in — docs/plans.md → "Tiers"). Sourced by
# scripts/plan.sh in a subshell; any runtime's hook can source it the same way.
# Values: frontier | standard | cheap (never auto — that is what these resolve).
# An empty value is the same as an absent line.
#
# Policy: kind of leaf work → tier. A node with `tier: auto` and `leaf: <label>`
# resolves through PLAN_TIER_<LABEL> (the label upper-cased) unless its plan.md
# overrides the label with `tier_<label>:`. A node with no `leaf:`, or a label
# with no row here, falls to the plan's `default_tier`. Edit the table to taste;
# these three are a starter, not a standard.
PLAN_TIER_RESEARCH=cheap
PLAN_TIER_DOCS=standard
PLAN_TIER_DESIGN=frontier

# Model knobs: PLAN_MODEL_<RUNTIME>_<TIER> is what that runtime's model flag
# takes. The runtime is `plan.sh --runtime`, else PLAN_RUNTIME, else the
# session's registry record. A tier with no knob for the running runtime means
# the session's own model, and `start` logs `tier <t> unavailable on <runtime>
# (session model)`. No model name ever reaches a plan or node file: the Log
# stamps the tier, and this file is the only place a model is named.
#   claude   — `claude --model <alias>`; the CLI aliases (opus/sonnet/haiku)
#              track the current generation, so no dated id is pinned here.
PLAN_MODEL_CLAUDE_FRONTIER=opus
PLAN_MODEL_CLAUDE_STANDARD=sonnet
PLAN_MODEL_CLAUDE_CHEAP=haiku
#   codex    — `codex --model <id>` (-m). Unset: every tier runs the session model.
#PLAN_MODEL_CODEX_FRONTIER=
#PLAN_MODEL_CODEX_STANDARD=
#PLAN_MODEL_CODEX_CHEAP=
#   gemini   — `gemini --model <id>` (-m). Unset.
#PLAN_MODEL_GEMINI_FRONTIER=
#PLAN_MODEL_GEMINI_STANDARD=
#PLAN_MODEL_GEMINI_CHEAP=
#   opencode — `opencode --model <provider/model>` (-m). Unset.
#PLAN_MODEL_OPENCODE_FRONTIER=
#PLAN_MODEL_OPENCODE_STANDARD=
#PLAN_MODEL_OPENCODE_CHEAP=
#   copilot  — `copilot --model <id>`. Unset.
#PLAN_MODEL_COPILOT_FRONTIER=
#PLAN_MODEL_COPILOT_STANDARD=
#PLAN_MODEL_COPILOT_CHEAP=
