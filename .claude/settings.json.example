{
  "_comment": "Starter Claude Code config. Copy to .claude/settings.local.json (gitignored) and tailor \u2014 scripts/setup.sh does this for you. Permissions are a personal trust decision \u2014 keep the copy out of git. The hooks block wires context-budget session registration (SessionStart), the WARN/STOP check (PostToolUse), and work-item lock release (SessionEnd) \u2014 see docs/context-budget.md. Every hook resolves the repo root itself rather than trusting $CLAUDE_PROJECT_DIR: a session launched with its cwd inside a subdirectory (a background job started in work/<project>/, for example) gets an empty or subdir-relative value, and the bare \"$CLAUDE_PROJECT_DIR\"/scripts/... form then fails on every tool call \u2014 noisily for PostToolUse, silently killing the WARN/STOP guardrail. The resolver trusts the variable only when it actually contains scripts/, else falls back to git rev-parse (correct inside worktrees too). The statusLine shows this session's work-item role (PRIMARY/AUXILIARY/SUPERSEDED) \u2014 see docs/context-budget.md -> 'Session roles'. disableClaudeAiConnectors keeps claude.ai account connectors (Gmail/Drive/Slack etc.) out of every session's standing tool surface, per the lean-by-default rule (CONTEXT.md -> 'Tool & Context Loading') \u2014 drop it if your project wants them. See docs/workspace-structure.md -> '.claude/ \u2014 Claude Code (Project-Level)'. The Stop hook is the session-loop supervisor's exit mechanism and is inert unless TF_SESSION_LOOP=1 \u2014 see docs/context-budget.md -> 'The supervisor'.",
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "d=\"${CLAUDE_PROJECT_DIR:-}\"; [ -d \"$d/scripts\" ] || d=$(git rev-parse --show-toplevel 2>/dev/null || pwd); exec \"$d\"/scripts/statusline-context-budget.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-}\"; [ -d \"$d/scripts\" ] || d=$(git rev-parse --show-toplevel 2>/dev/null || pwd); t=$(jq -r '.transcript_path // empty' 2>/dev/null); \"$d\"/scripts/context-budget.sh register --runtime claude ${t:+--transcript \"$t\"} || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-}\"; [ -d \"$d/scripts\" ] || d=$(git rev-parse --show-toplevel 2>/dev/null || pwd); h=\"$d/scripts/hooks/context-budget-claude-hook.sh\"; [ -x \"$h\" ] || exit 0; exec \"$h\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-}\"; [ -d \"$d/scripts\" ] || d=$(git rev-parse --show-toplevel 2>/dev/null || pwd); t=$(jq -r '.transcript_path // empty' 2>/dev/null); \"$d\"/scripts/context-budget.sh release --runtime claude ${t:+--transcript \"$t\"} --quiet || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-}\"; [ -d \"$d/scripts\" ] || d=$(git rev-parse --show-toplevel 2>/dev/null || pwd); h=\"$d/scripts/hooks/context-budget-stop-hook.sh\"; [ -x \"$h\" ] || exit 0; exec \"$h\" claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "WebSearch"
    ]
  },
  "enabledMcpjsonServers": [
    "graphify",
    "youtube-transcript"
  ]
}
