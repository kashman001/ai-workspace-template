{
  "_comment": "Starter for your PERSONAL Claude Code settings. Copy to .claude/settings.local.json (gitignored) and tailor — scripts/setup.sh does this for you. Permissions are a personal trust decision — keep the copy out of git. Hook wiring does NOT live here: the context-budget hooks and statusLine are template-owned and committed in .claude/settings.json, so they update with git pull like every other runtime's hook deployment (docs/context-budget.md -> 'Vendor hook deployments'). Claude Code merges hooks from both files — do NOT copy hooks into settings.local.json, or each copy fires per event. disableClaudeAiConnectors keeps claude.ai account connectors (Gmail/Drive/Slack etc.) out of every session's standing tool surface, per the lean-by-default rule (CONTEXT.md -> 'Tool & Context Loading') — drop it if your project wants them. See docs/workspace-structure.md -> '.claude/ — Claude Code (Project-Level)'.",
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "WebSearch"
    ]
  },
  "enabledMcpjsonServers": [
    "graphify",
    "youtube-transcript"
  ]
}
