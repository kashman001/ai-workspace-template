{
  "_comment": "Starter Claude Code config. Copy to .claude/settings.local.json (gitignored) and tailor — scripts/setup.sh does this for you. Permissions are a personal trust decision — keep the copy out of git. The hooks block wires context-budget session registration (SessionStart), the WARN/STOP check (PostToolUse), and work-item lock release (SessionEnd) — see docs/context-budget.md. The statusLine shows this session's work-item role (PRIMARY/AUXILIARY/SUPERSEDED) — see docs/context-budget.md -> 'Session roles'. See docs/workspace-structure.md -> '.claude/ — Claude Code (Project-Level)'.",
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/statusline-context-budget.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "t=$(jq -r '.transcript_path // empty' 2>/dev/null); \"$CLAUDE_PROJECT_DIR\"/scripts/context-budget.sh register --runtime claude ${t:+--transcript \"$t\"} || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/context-budget-claude-hook.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "t=$(jq -r '.transcript_path // empty' 2>/dev/null); \"$CLAUDE_PROJECT_DIR\"/scripts/context-budget.sh release --runtime claude ${t:+--transcript \"$t\"} --quiet || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "WebSearch"
    ]
  },
  "enabledMcpjsonServers": [
    "graphify",
    "youtube-transcript"
  ]
}
