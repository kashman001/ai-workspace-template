# Context-budget thresholds (non-secret, checked in — see docs/context-budget.md).
# The "dumb zone": LLM quality degrades past ~150K context tokens regardless of
# advertised window size. These are absolute counts, NOT fractions of the
# advertised window — effective context is a training-distribution property
# (RULER, arxiv 2404.06654) and moves per model generation. Re-measure when
# adopting a new model; never scale with the advertised size. Mechanism:
# anthropic.com/engineering/effective-context-engineering-for-ai-agents,
# aihero.dev/ai-coding-dictionary/smart-zone. Raise in one place as models
# improve. STOP must stay below the runtime's auto-compact trigger (150K <
# Claude Code's ~200K) or compaction fires before the deliberate rollover gets
# its chance.
CONTEXT_DUMB_ZONE_TOKENS=150000
CONTEXT_DUMB_ZONE_WARN_TOKENS=120000

# Advisory work-item lock (work/<proj>/.active-session): a holder whose session
# artifact is untouched for this many seconds is considered dead and its lock
# reclaimable by the next `register --project`.
CONTEXT_LOCK_STALE_SECS=10800

# Relaunch behavior at session-rollover's closing step (docs/context-budget.md
# → "Relaunch knobs"):
#   off    — emit the paste-ready bootstrap prompt only
#   manual — consent-gated: the agent asks, then runs launch-next-session.sh itself
#   auto   — background-launch the successor where the runtime supports it
#            (claude --bg); fall back to manual elsewhere
ROLLOVER_RELAUNCH=auto
# Fallback default runtime only — the actual relaunch runtime comes from the
# dying session's own registry record.
ROLLOVER_RUNTIME=claude

# Session-loop supervisor (scripts/session-loop.sh; docs/context-budget.md ->
# "The supervisor"). Each is a guard against an unattended chain misbehaving in
# a way no human is present to notice.
#   MAX_SESSIONS  — chain cap: stop after this many sessions, whatever happens.
#   MIN_LIFETIME  — a session that rolls over faster than this did not do work;
#                   almost certainly a first-turn spurious STOP (failure mode 1).
#                   Set to 0 to disable.
#   STALL_LIMIT   — halt after this many consecutive hands-off sessions whose
#                   only commits touched the rollover bookkeeping set. Rollover
#                   is itself a commit, so an unqualified commit test is a
#                   heartbeat, not a signal. Set to 0 to disable.
SESSION_LOOP_MAX_SESSIONS=10
SESSION_LOOP_MIN_LIFETIME=60
SESSION_LOOP_STALL_LIMIT=3
