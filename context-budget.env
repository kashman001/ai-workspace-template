# Context-budget thresholds (non-secret, checked in — see docs/context-budget.md).
# The "dumb zone": LLM quality degrades past ~150K context tokens regardless of
# advertised window size. These are absolute counts, NOT fractions of the
# advertised window — effective context is a training-distribution property
# (RULER, arxiv 2404.06654) and moves per model generation. Re-measure when
# adopting a new model; never scale with the advertised size. Mechanism:
# anthropic.com/engineering/effective-context-engineering-for-ai-agents,
# aihero.dev/ai-coding-dictionary/smart-zone. Raise in one place as models
# improve. STOP must stay below the runtime's auto-compact trigger (150K <
# Claude Code's ~200K) or compaction fires before the deliberate rollover gets
# its chance.
CONTEXT_DUMB_ZONE_TOKENS=150000
CONTEXT_DUMB_ZONE_WARN_TOKENS=120000

# Owner liveness fallback: a recorded owner with no process id (copilot-vscode,
# gemini) counts as alive while its transcript was written within this many
# seconds; owners with a pid are judged by the pid alone (ADR-0010).
CONTEXT_LOCK_STALE_SECS=10800

# Relaunch behavior at session-rollover's closing step (docs/context-budget.md
# → "Relaunch knobs"):
#   off    — emit the paste-ready bootstrap prompt only, AND refuse a supervisor
#            start against that work item. Widened 2026-09-14 (scenario B3):
#            it used to mean only "do not spawn a successor behind my back",
#            which left an item committing it still runnable unattended for ten
#            sessions. scripts/session-loop.sh <p> --relaunch-override is the
#            explicit way in.
#   manual — consent-gated: at WARN the agent asks, then runs launch-next-session.sh
#   auto   — no ask: the agent runs the launcher itself; the successor starts
#            attached (foreground) — there is no background launch path
# Default flipped auto -> manual 2026-09-16 (Stage 4 phase 0 of
# work/template-improvement-review): while the session scripts are rebuilt, no
# work item chains unattended unless its own work/<proj>/context-budget.env
# says so.
ROLLOVER_RELAUNCH=manual
# Fallback default runtime only — the actual relaunch runtime comes from the
# dying session's own registry record.
ROLLOVER_RUNTIME=claude

# Session-loop supervisor (scripts/session-loop.sh; docs/context-budget.md ->
# "The supervisor"). Each is a guard against an unattended chain misbehaving in
# a way no human is present to notice.
#   MAX_SESSIONS  — chain cap: stop after this many sessions, whatever happens.
#   MIN_LIFETIME  — a session that rolls over faster than this did not do work;
#                   almost certainly a first-turn spurious STOP (failure mode 1).
#                   Set to 0 to disable.
#   STALL_LIMIT   — halt after this many consecutive hands-off sessions whose
#                   only commits touched the rollover bookkeeping set. Rollover
#                   is itself a commit, so an unqualified commit test is a
#                   heartbeat, not a signal. Set to 0 to disable.
SESSION_LOOP_MAX_SESSIONS=10
SESSION_LOOP_MIN_LIFETIME=60
SESSION_LOOP_STALL_LIMIT=3
#   ALARM         — while a child session is running with no exit, repeat a
#                   notification every N seconds. Pure observability: it never
#                   touches the child (the eval is foreground and tty-inheriting
#                   on purpose). Default ON as of 2026-09-10 — it had been
#                   opt-in per work item, and the two chains that did NOT opt in
#                   (policy-dev-onboarding, token-factory) each hung silently for
#                   hours/days while cm_bugs' 900s alarm made the identical
#                   failure visible within 15 minutes. A guard nobody enables is
#                   not a guard. Set to 0 to disable for one work item.
#                   As of R2.18 this is the POLL interval, not the trigger: a
#                   tick only pages when the session's transcript has stopped
#                   growing, and otherwise writes a plain log line. Before that
#                   change it paged every healthy session — #28 of
#                   session-loop-hardening drew three pages across 59 productive
#                   minutes — so 900s stands unchanged and the noise it caused
#                   is gone instead.
SESSION_LOOP_ALARM=900
#   ALARM_MAX     — ceiling for the stall interval, which doubles from ALARM
#                   after each page and resets when the session is seen writing
#                   again. A dead session is dead for days (3d 20h measured), so
#                   a flat 900s is ~368 identical pages.
SESSION_LOOP_ALARM_MAX=3600
#   KILL_AFTER    — seconds of TRANSCRIPT silence after which the supervisor
#                   ends the child (D7 item 3). 0 = off, and off is today's
#                   behaviour exactly. Never fires on quiet: it needs the
#                   record's session.pid to resolve to a live child of this
#                   supervisor AND that session's transcript (session.artifact)
#                   to be readable, so missing evidence always means notify-only.
#                   Default ON at 4h by the operator's decision (s29), because
#                   arming it changes behaviour for UNSUPERVISED rollovers and
#                   that is the one class this work item escalates to a human.
#                   4h is ~4x the longest legitimate session (they are bounded
#                   by the context budget at ~60 min) and ~23x below the 3d 20h
#                   block that motivated it. A human rescuing a vendor logout
#                   writes to the transcript far more often than every 4h.
#                   Full reasoning: work/session-loop-hardening/defects.md -> D7
#                   item 3. Set to 0 to disable for one work item.
SESSION_LOOP_KILL_AFTER=14400
#   NOTIFY        — route halt/stall messages to a desktop notification as well
#                   as the log. Default ON as of R2.18, and only safe because of
#                   it: while a stall page fired on wall-clock alone, a global
#                   default would have rung the operator several times per
#                   healthy session and been muted within a day. Now a page
#                   means the transcript stopped. Set to empty to disable.
#                 Resolved from this file's own location so every caller
#                 (supervisor, launcher, measurer) gets the same path with no
#                 ROOT variable in play.
SESSION_LOOP_NOTIFY="$(cd "$(dirname "${BASH_SOURCE[0]:-.}")" && pwd)/scripts/session-loop-notify.sh"
